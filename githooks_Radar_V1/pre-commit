#!/bin/sh
# Git requiere exactamente este nombre para el hook.
set -eu
RADAR_REPO_ROOT=$(git rev-parse --show-toplevel)
RADAR_DOC_PYTHON=${RADAR_PYTHON:-"$HOME/anaconda3/envs/radar-v1/bin/python"}
if [ ! -x "$RADAR_DOC_PYTHON" ]; then RADAR_DOC_PYTHON=python3; fi
exec "$RADAR_DOC_PYTHON" -B "$RADAR_REPO_ROOT/scr_Radar_V1/operaciones_Radar_V1/actualizar_documentacion_Radar_V1.py" --check-staged
