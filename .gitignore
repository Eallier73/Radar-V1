# Entornos virtuales locales de Conda
.conda_envs/

# Archivo de variables de entorno
.env

# Sesiones autenticadas locales (Playwright/Twitter)
/state/*.json

# Archivos retirados: respaldo local, nunca entrada del pipeline ni publicacion.
/trash/*
!/trash/README.md
!/trash/manifest_*.json

# Cache de Python regenerable.
__pycache__/
*.py[cod]

# Metadatos del sistema operativo sin uso por el pipeline.
.DS_Store
._*
